# ============================================================
# AISecGuard — Environment Variables (Development Template)
# ============================================================
# IMPORTANT: Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# Project
PROJECT_NAME=AISecGuard
VERSION=0.1.0

# Database (In-Memory by default — zero disk database files or setup required)
DATABASE_URL=sqlite:///:memory:
NO_LOGIN_REQUIRED=true

# Database (Optional persistent SQLite or PostgreSQL)
# DATABASE_URL=sqlite:///./aisecguard_dev.db
# DATABASE_URL=postgresql+psycopg2://aisecguard:aisecguard_password@localhost:5432/aisecguard

# Security (CHANGE THIS in production — use a long random string)
SECRET_KEY=dev_secret_key_change_in_production_abc123xyz789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File upload settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# CORS Origins (frontend dev server)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
